{
    "name": "curvemetrics/approval-management",
    "type": "project",
    "description": "Production-ready Agency Client Approval Portal (Open-Source Edition)",
    "keywords": ["approval", "client-portal", "agency", "creative-review", "open-source", "hostinger"],
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-json": "*",
        "ext-bcmath": "*",
        "ext-gd": "*",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "inertiajs/inertia-laravel": "^1.0",
        "predis/predis": "^2.2",
        "symfony/mailer": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
