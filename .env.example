# ==============================================================================
# ApexApprove - Environment Configuration Template
# ==============================================================================

APP_NAME="ApexApprove"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# MULTI-TENANCY & EDITIONS
# ------------------------------------------------------------------------------
# Set to true for single-agency self-hosted installation
SINGLE_TENANT_MODE=true
BASE_DOMAIN=localhost

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL 16)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=apex_db
DB_USERNAME=apex_user
DB_PASSWORD=change_this_strong_postgres_password_in_production

# ------------------------------------------------------------------------------
# QUEUE, CACHE & SESSION (Redis 7)
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=change_this_strong_redis_password_in_production
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Hostinger Business SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contact@curvemetrics.in
MAIL_PASSWORD=YOUR_HOSTINGER_EMAIL_PASSWORD_HERE
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@curvemetrics.in"
MAIL_FROM_NAME="Curve Metrics Approval Portal"

# ------------------------------------------------------------------------------
# GUEST REVIEW VERIFICATION (Email OTP)
# ------------------------------------------------------------------------------
# OTP validity window in minutes (Default: 15)
OTP_EXPIRY_MINUTES=15
# Maximum failed verification attempts before 1-hour lockout
OTP_MAX_ATTEMPTS=5
# Minimum delay between resend OTP requests in seconds
OTP_RESEND_THROTTLE_SECONDS=60

# ------------------------------------------------------------------------------
# FILE STORAGE & PROCESSING
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
MAX_IMAGE_SIZE_MB=50
MAX_PDF_SIZE_MB=250
MAX_VIDEO_SIZE_MB=2048

# Enable local FFmpeg conversions (Requires --profile media-worker)
ENABLE_FFMPEG_WORKER=false
FFMPEG_MAX_CONCURRENT_JOBS=1
FFMPEG_PROCESS_TIMEOUT_SECONDS=600

# ------------------------------------------------------------------------------
# RATE LIMITING & SECURITY HEADERS
# ------------------------------------------------------------------------------
THROTTLE_GUEST_REVIEWS_PER_MIN=15
SECURITY_CONTACT_EMAIL="contact@curvemetrics.in"
